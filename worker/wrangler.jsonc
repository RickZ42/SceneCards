{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "scenecards-mobile-inbox",
  "main": "index.js",
  "compatibility_date": "2026-09-22",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNT_DATA", "class_name": "AccountData" }]
  },
  "migrations": [{ "tag": "private-accounts-v1", "new_sqlite_classes": ["AccountData"] }],
  "ratelimits": [{ "name": "ACCOUNT_RATE_LIMIT", "namespace_id": "104202601", "simple": { "limit": 120, "period": 60 } }],
  "kv_namespaces": [
    {
      "binding": "CAPTURES"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://rickz42.github.io,http://127.0.0.1:5173,http://localhost:5173"
  },
  "secrets": {
    "required": ["INBOX_KEY", "INBOX_ENCRYPTION_KEY"]
  }
}
